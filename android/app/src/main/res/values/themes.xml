<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Songbook" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/color_primary</item>
        <item name="android:colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/color_bg</item>
        <item name="android:statusBarColor">@color/color_bg</item>
        <item name="android:navigationBarColor">@color/color_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:textColorSecondary">@color/color_text_muted</item>
    </style>


    <!-- Typography scale -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Text.Eyebrow" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.Label" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
    </style>
    <style name="Text.Value" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Text.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
    </style>

    <!-- Controls -->
    <style name="Button.Primary" parent="">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/color_on_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Button.Secondary" parent="">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Field" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textColorHint">@color/color_text_muted</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Row">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SwitchRow">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
