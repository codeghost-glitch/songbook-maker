<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingTop="@dimen/space_5"
            android:paddingBottom="@dimen/space_3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                style="@style/Text.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tagline"
                style="@style/Text.Subtitle" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="140dp"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_5">

                <!-- 01 Song list -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_file"
                        style="@style/Text.Eyebrow" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/space_3">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_file"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_3"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="middle"
                                android:text="@string/no_file"
                                style="@style/Text.Value" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:visibility="gone"
                                style="@style/Text.Caption" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnPick"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="@dimen/space_3"
                            android:paddingStart="@dimen/space_4"
                            android:paddingEnd="@dimen/space_4"
                            android:text="@string/pick_file"
                            style="@style/Button.Secondary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pick_hint"
                        style="@style/Text.Body" />

                    <LinearLayout
                        android:id="@+id/bannerRejected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:background="@drawable/bg_banner_error"
                        android:orientation="vertical"
                        android:padding="@dimen/space_3"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvRejected"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_danger"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 02 Page layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_layout"
                        style="@style/Text.Eyebrow" />

                    <LinearLayout
                        android:id="@+id/rowPaper"
                        style="@style/Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/paper"
                            style="@style/Text.Value" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvPaper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:src="@drawable/ic_chevron"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_border" />

                    <LinearLayout
                        android:id="@+id/rowColumns"
                        style="@style/Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/columns"
                            style="@style/Text.Value" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvColumns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:src="@drawable/ic_chevron"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_border" />

                    <LinearLayout
                        android:id="@+id/rowMargin"
                        style="@style/Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/margin"
                            style="@style/Text.Value" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvMargin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:src="@drawable/ic_chevron"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_border" />

                    <LinearLayout
                        android:id="@+id/rowSections"
                        style="@style/Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sections"
                            style="@style/Text.Value" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvSections"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:src="@drawable/ic_chevron"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_border" />

                    <LinearLayout
                        android:id="@+id/rowSort"
                        style="@style/Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sort"
                            style="@style/Text.Value" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:src="@drawable/ic_chevron"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 03 Look -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_look"
                        style="@style/Text.Eyebrow" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/title_text"
                        style="@style/Text.Caption" />

                    <EditText
                        android:id="@+id/etTitle"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/space_1"
                        android:hint="@string/title_hint"
                        android:inputType="textCapWords"
                        android:imeOptions="actionNext"
                        android:autofillHints="none" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/footer_text"
                        style="@style/Text.Caption" />

                    <EditText
                        android:id="@+id/etFooter"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/space_1"
                        android:hint="@string/footer_hint"
                        android:inputType="textCapSentences"
                        android:imeOptions="actionDone"
                        android:autofillHints="none" />

                    <Switch
                        android:id="@+id/swBold"
                        style="@style/SwitchRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:checked="true"
                        android:text="@string/bold" />

                    <Switch
                        android:id="@+id/swNumbers"
                        style="@style/SwitchRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/numbers" />

                    <Switch
                        android:id="@+id/swMirror"
                        style="@style/SwitchRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mirror" />

                    <Switch
                        android:id="@+id/swArtist"
                        style="@style/SwitchRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/artist_col" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Sticky action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/color_surface"
        android:elevation="16dp"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_3">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="@dimen/space_3"
            android:background="@color/color_border" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            android:background="@drawable/bg_banner_ok"
            android:padding="@dimen/space_3"
            android:textColor="@color/color_ok"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCreate"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/create" />

            <Button
                android:id="@+id/btnShare"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="0.55"
                android:enabled="false"
                android:alpha="0.45"
                android:text="@string/open" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
