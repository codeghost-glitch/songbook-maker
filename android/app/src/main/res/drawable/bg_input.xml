<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="2dp" android:color="@color/color_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_alt" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="1dp" android:color="@color/color_border" />
        </shape>
    </item>
</selector>
